# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)

# Supabase > Project Settings > Database > Connection string (แนะนำแบบ Session pooler)
# แทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูลที่ตั้งตอนสร้าง Project
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# origin ของหน้าเว็บที่อนุญาตให้เรียก API คั่นด้วย , (ตอน deploy เพิ่ม URL ของ Vercel)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
